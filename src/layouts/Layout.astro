---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Calculate the ROI of Netwrix Privilege Secure and Netwrix PolicyPak for your organization." />
    <link rel="icon" type="image/svg+xml" href="/images/Netwrix_Tagline_Dark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hubot+Sans:wght@400;500;600;700&family=Syne:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <div class="header-left">
          <span class="header-badge">ROI Calculator</span>
        </div>
        <div class="header-right">
          <svg class="netwrix-logo" width="127" height="27" viewBox="0 0 127 27" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Netwrix">
            <g clip-path="url(#clip0_layout_logo)">
              <path d="M4.73582 11.0159H0V26.099H4.73582V11.0159Z" fill="#00050A"/>
              <path d="M20.1402 13.9465V26.0988H15.4043V11.0157H4.73535C4.75322 10.98 4.77109 10.9442 4.78896 10.8906C5.23574 10.0328 5.82548 9.24647 6.54032 8.5495C7.27304 7.8704 8.13084 7.3164 9.11375 6.92324C10.0967 6.53008 11.2047 6.3335 12.3841 6.3335C13.5636 6.3335 14.5287 6.49434 15.4758 6.79814C16.423 7.10195 17.2629 7.60234 17.9599 8.22782C18.6569 8.87118 19.193 9.67538 19.5683 10.6047C19.9436 11.534 20.1402 12.6598 20.1402 13.9108V13.9465Z" fill="#00050A"/>
              <path d="M73.1456 26.0991L68.1239 12.678L62.977 26.0991H58.6522L51.2715 6.7627H56.4541L60.9576 20.0051L65.5147 6.7627H70.8045L75.1829 19.9872L79.8115 6.7627H85.012L77.4704 26.0991H73.1456Z" fill="#00050A"/>
              <path d="M90.6948 6.7627H85.959V26.0991H90.6948V6.7627Z" fill="#00050A"/>
              <path d="M97.4677 6.7625V11.3911H90.6768C90.6946 11.3554 90.7125 11.3196 90.7304 11.266C91.1771 10.4082 91.7669 9.62186 92.4817 8.92489C93.2144 8.24579 94.0723 7.69179 95.0552 7.29863C95.7879 7.01269 96.6099 6.81611 97.4677 6.74463V6.7625Z" fill="#00050A"/>
              <path d="M98.7012 26.0991V6.7627H103.473V26.0991H98.7012Z" fill="#00050A"/>
              <path d="M103.473 0.900879H98.7012V5.67244H103.473V0.900879Z" fill="#00050A"/>
              <path d="M126.187 6.7627H120.557L115.464 12.9997L110.353 6.7627H104.724L112.64 16.4309L104.724 26.0991H110.353L115.464 19.8621L120.557 26.0991H126.187L118.27 16.4309L126.187 6.7627Z" fill="#00050A"/>
              <path d="M50.3787 10.7299V6.76257H45.5356V0.900879H40.7998V20.0586C40.7998 23.4005 43.4983 26.099 46.8402 26.099H50.3787V21.3632H45.5356V10.7299H50.3787Z" fill="#00050A"/>
              <path d="M21.749 12.8029V19.1292C21.749 22.9894 24.8765 26.0989 28.7187 26.0989H36.8322V21.3631H26.4848V18.0212H39.209V12.785C39.209 9.44315 36.5105 6.74463 33.1686 6.74463H27.7894C24.4475 6.74463 21.749 9.44315 21.749 12.785V12.8029ZM34.4553 14.0717H26.467V10.7299H34.4553V14.0717Z" fill="#00050A"/>
            </g>
            <defs>
              <clipPath id="clip0_layout_logo">
                <rect width="126.187" height="25.1981" fill="white" transform="translate(0 0.900879)"/>
              </clipPath>
            </defs>
          </svg>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Netwrix Corporation. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    padding: var(--space-lg) 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 800px;
  }

  .header-badge {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-vigilant-blue);
    background: rgba(88, 81, 219, 0.1);
    border: 1px solid rgba(88, 81, 219, 0.2);
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-md);
    letter-spacing: 0.02em;
  }

  .netwrix-logo {
    height: 24px;
    width: auto;
  }

  main {
    position: relative;
    z-index: 1;
    padding: var(--space-lg) 0 var(--space-3xl);
  }

  .site-footer {
    position: relative;
    z-index: 1;
    padding: var(--space-xl) 0;
    text-align: center;
    border-top: 1px solid rgba(35, 26, 64, 0.06);
  }

  .site-footer p {
    font-size: 0.85rem;
    color: rgba(35, 26, 64, 0.5);
    margin: 0;
  }
</style>
