---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Calculate the ROI of Netwrix Privilege Secure and Netwrix PolicyPak for your organization." />
    <link rel="icon" type="image/svg+xml" href="/images/Netwrix_Tagline_Dark.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <div class="header-left">
          <span class="header-badge">ROI Calculator</span>
        </div>
        <div class="header-right">
          <img
            src="/images/Netwrix_Logo_Dark.svg"
            alt="Netwrix"
            class="netwrix-logo"
          />
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Netwrix Corporation. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    padding: var(--space-lg) 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 800px;
  }

  .header-badge {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-vigilant-blue);
    background: rgba(88, 81, 219, 0.1);
    border: 1px solid rgba(88, 81, 219, 0.2);
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-md);
    letter-spacing: 0.02em;
  }

  .netwrix-logo {
    height: 32px;
    width: auto;
    object-fit: contain;
  }

  main {
    position: relative;
    z-index: 1;
    padding: var(--space-lg) 0 var(--space-3xl);
  }

  .site-footer {
    position: relative;
    z-index: 1;
    padding: var(--space-xl) 0;
    text-align: center;
    border-top: 1px solid rgba(35, 26, 64, 0.06);
  }

  .site-footer p {
    font-size: 0.85rem;
    color: rgba(35, 26, 64, 0.5);
    margin: 0;
  }
</style>
