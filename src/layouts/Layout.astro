---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Calculate the ROI of Netwrix Privilege Secure and Netwrix PolicyPak for your organization." />
    <link rel="icon" type="image/svg+xml" href="/images/Netwrix_Tagline_Dark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hubot+Sans:wght@400;500;600;700&family=Syne:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <img src="/netwrix-logo-white.svg" alt="Netwrix" class="netwrix-logo" />
        <a href="https://netwrix.com/en/products/privilege-secure/"
           class="header-nav-link"
           target="_blank" rel="noopener noreferrer">
          Learn about Netwrix Privilege Secure →
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="footer-disclaimer">
          This document is for informational purposes only and does not constitute a commitment from Netwrix Corporation of any return on investment from the Netwrix products or services. Netwrix hereby disclaims all warranties related to the information in this document, whether express or implied, including but not limited to the implied warranties of merchantability and fitness for a particular purpose. This document does not provide you with any legal rights whatsoever including, without limitation, with respect to the information you submitted to generate an estimated return on investment or the estimated return on investment generated by that information. You may copy and use this document only for your internal, reference purposes.
        </p>
        <p class="footer-copyright">&copy; 2026 Netwrix Corporation. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    background: #231A40;
    width: 100%;
  }

  .header-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .netwrix-logo {
    height: 24px;
    width: auto;
  }

  .header-nav-link {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: rgba(252, 250, 245, 0.70);
    text-decoration: none;
    transition: color 150ms;
  }

  .header-nav-link:hover {
    color: rgba(252, 250, 245, 1.00);
  }

  main {
    position: relative;
    z-index: 1;
    padding: var(--space-lg) 0 var(--space-3xl);
  }

  .site-footer {
    position: relative;
    z-index: 1;
    padding: var(--space-xl) 0 var(--space-2xl);
    border-top: 1px solid rgba(35, 26, 64, 0.06);
  }

  .footer-disclaimer {
    font-size: 0.75rem;
    color: #9ca3af;
    font-family: var(--font-body);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .footer-copyright {
    font-size: 0.75rem;
    color: #9ca3af;
    font-family: var(--font-body);
    margin: 0;
  }
</style>
