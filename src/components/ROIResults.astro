---
---

<section id="roi-results" class="results-card" style="display: none;">
  <div class="results-header">
    <div class="results-header__eyebrow">Your ROI Estimate</div>
    <div class="results-header__title">3-Year Investment Summary</div>
  </div>

  <div class="results-body">
    <!-- Primary metric: ROI % -->
    <div class="primary-metric">
      <div class="primary-metric__label">Return on Investment</div>
      <div class="primary-metric__value" id="result-roi">—</div>
      <div class="primary-metric__sub">3-year discounted return on your total investment</div>
    </div>

    <!-- Secondary tiles -->
    <div class="metric-grid">
      <div class="metric-tile">
        <div class="metric-tile__value" id="result-investment">—</div>
        <div class="metric-tile__label">Initial Investment</div>
      </div>
      <div class="metric-tile">
        <div class="metric-tile__value" id="result-annual-savings">—</div>
        <div class="metric-tile__label">Annual Cost Savings</div>
      </div>
      <div class="metric-tile">
        <div class="metric-tile__value" id="result-discounted-savings">—</div>
        <div class="metric-tile__label">3-Year Discounted Savings</div>
      </div>
    </div>

    <hr class="results-divider" />

    <!-- Payback period standout row -->
    <div class="hours-row">
      <div>
        <div class="hours-row__value" id="result-payback">—</div>
        <div class="hours-row__label">Payback period</div>
      </div>
      <div class="hours-row__icon">⏱</div>
    </div>

    <hr class="results-divider" />

    <!-- Savings breakdown -->
    <div class="breakdown-title">How Your Annual Savings Were Calculated</div>

    <div class="breakdown-row">
      <div class="breakdown-row__label">
        <span class="breakdown-row__dot" style="background: var(--color-vigilant-blue);"></span>
        5% reduction in IT &amp; security staff time — rotating passwords, GPO policies, and managing local access
      </div>
      <div class="breakdown-row__value" id="assumption-it-savings">—</div>
    </div>

    <div class="breakdown-row">
      <div class="breakdown-row__label">
        <span class="breakdown-row__dot" style="background: var(--color-beacon-green);"></span>
        25% reduction in IAM staff time — implementing, maintaining, and auditing zero-standing privilege
      </div>
      <div class="breakdown-row__value" id="assumption-admin-savings">—</div>
    </div>

    <div class="breakdown-row breakdown-row--total">
      <div class="breakdown-row__label">Total Annual Savings</div>
      <div class="breakdown-row__value" id="result-breakdown-total">—</div>
    </div>

    <div class="disclaimer">
      Results are directional estimates based on industry benchmarks and your inputs.
      Actual savings will vary. Consult a Netwrix advisor for a tailored assessment.
    </div>
  </div>
</section>

<style>
  .results-card {
    background: var(--color-nightwatch);
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-top: var(--space-xl);
    animation: slideUp 0.5s ease forwards;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Header ─────────────────────────────────────────────── */
  .results-header {
    padding: 1.5rem 1.75rem 1.25rem;
    border-bottom: 1px solid rgba(252, 250, 245, 0.08);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .results-header__eyebrow {
    font-size: 0.65rem;
    font-weight: 600;
    font-family: var(--font-body);
    color: rgba(252, 250, 245, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.3rem;
  }

  .results-header__title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-access-white);
    letter-spacing: -0.01em;
  }

  .btn-pdf {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-vigilant-blue);
    border: none;
    border-radius: var(--radius-md);
    color: var(--color-access-white);
    font-size: 0.875rem;
    font-weight: 700;
    font-family: var(--font-body);
    padding: 0.75rem 1.75rem;
    cursor: pointer;
    transition: background 0.15s;
    flex-shrink: 0;
  }

  .btn-pdf:hover { background: rgba(88, 81, 219, 0.85); }
  .btn-pdf:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(88, 81, 219, 0.3);
  }

  /* ── Body ───────────────────────────────────────────────── */
  .results-body {
    padding: 1.5rem 1.75rem 1.75rem;
  }

  /* Primary metric */
  .primary-metric {
    margin-bottom: 1.5rem;
  }

  .primary-metric__label {
    font-size: 0.68rem;
    font-weight: 600;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(252, 250, 245, 0.4);
    margin-bottom: 0.3rem;
  }

  .primary-metric__value {
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-beacon-green);
    line-height: 1;
    letter-spacing: -0.025em;
    margin-bottom: 0.25rem;
  }

  .primary-metric__sub {
    font-size: 0.775rem;
    color: rgba(252, 250, 245, 0.45);
    font-family: var(--font-body);
  }

  /* Secondary metric tiles */
  .metric-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 480px) {
    .metric-grid { grid-template-columns: 1fr 1fr; }
  }

  .metric-tile {
    background: rgba(252, 250, 245, 0.05);
    border: 1px solid rgba(252, 250, 245, 0.08);
    border-radius: var(--radius-sm);
    padding: 1rem;
  }

  .metric-tile__value {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-access-white);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.3rem;
    font-variant-numeric: tabular-nums;
  }

  .metric-tile__label {
    font-size: 0.7rem;
    font-family: var(--font-body);
    color: rgba(252, 250, 245, 0.45);
    line-height: 1.3;
  }

  /* Divider */
  .results-divider {
    border: none;
    border-top: 1px solid rgba(252, 250, 245, 0.08);
    margin: 1.25rem 0;
  }

  /* Payback row */
  .hours-row {
    background: rgba(252, 250, 245, 0.04);
    border: 1px solid rgba(252, 250, 245, 0.07);
    border-radius: var(--radius-sm);
    padding: 1rem 1.125rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hours-row__value {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-access-white);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .hours-row__label {
    font-size: 0.72rem;
    color: rgba(252, 250, 245, 0.4);
    font-family: var(--font-body);
    margin-top: 0.15rem;
  }

  .hours-row__icon {
    font-size: 1.5rem;
    opacity: 0.2;
  }

  /* Breakdown table */
  .breakdown-title {
    font-size: 0.65rem;
    font-weight: 600;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(252, 250, 245, 0.3);
    margin-bottom: 0.625rem;
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.55rem 0;
    border-top: 1px solid rgba(252, 250, 245, 0.06);
    gap: var(--space-lg);
  }

  .breakdown-row:first-of-type { border-top: none; }

  .breakdown-row__label {
    font-size: 0.8rem;
    font-family: var(--font-body);
    color: rgba(252, 250, 245, 0.65);
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    flex: 1;
    line-height: 1.45;
  }

  .breakdown-row__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 0.4rem;
  }

  .breakdown-row__value {
    font-size: 0.825rem;
    font-family: var(--font-heading);
    font-weight: 600;
    color: rgba(65, 242, 124, 0.8);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .breakdown-row--total {
    border-top: 1px solid rgba(252, 250, 245, 0.12) !important;
    margin-top: 0.25rem;
    padding-top: 0.75rem;
  }

  .breakdown-row--total .breakdown-row__label {
    font-weight: 600;
    color: var(--color-access-white);
    font-size: 0.85rem;
  }

  .breakdown-row--total .breakdown-row__value {
    color: var(--color-beacon-green);
    font-size: 0.925rem;
  }

  /* Disclaimer */
  .disclaimer {
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    background: rgba(252, 250, 245, 0.03);
    border: 1px solid rgba(252, 250, 245, 0.06);
    border-radius: var(--radius-sm);
    font-size: 0.68rem;
    color: rgba(252, 250, 245, 0.3);
    font-family: var(--font-body);
    line-height: 1.5;
  }

  /* Recalculate link */
  .recalc-row {
    margin-top: 1rem;
    text-align: center;
  }

  .recalc-link {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: rgba(252, 250, 245, 0.35);
    transition: color 150ms;
  }

  .recalc-link:hover {
    color: rgba(252, 250, 245, 0.65);
  }

  /* Spinner inside PDF button */
  .spinner {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(252, 250, 245, 0.3);
    border-radius: 50%;
    border-top-color: var(--color-access-white);
    animation: spin 0.6s ease-in-out infinite;
    vertical-align: middle;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 599px) {
    .results-body { padding: 1.25rem; }
    .results-header { padding: 1.25rem; }
    .metric-grid { grid-template-columns: 1fr 1fr; }
    .primary-metric__value { font-size: 2.25rem; }
    .btn-pdf { width: 100%; justify-content: center; }
  }
</style>
